{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "files": {
    "ignore": ["**/node_modules/**", "**/dist/**", "**/build/**", "**/*.html", "**/__pycache__/**", "**/.venv/**", "**/coverage/**", "**/.git/**"]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "include": ["**/*.py"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
