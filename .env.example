# PowerCV Environment Configuration Template
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env to version control

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# User Information for CV Export (placeholders - override in production)
USER_FIRST_NAME=YourFirstName
USER_LAST_NAME=YourLastName

# Security - CHANGE THIS IN PRODUCTION
SECRET_KEY=your-secret-key-change-in-production-32-chars-min

# =============================================================================
# AI PROVIDER API KEYS
# =============================================================================

# Primary AI Provider (Cerebras)
CEREBRAS_API_KEY=your-cerebras-api-key-here
CEREBRAS_API_BASE=https://api.cerebras.ai/v1
CEREBRAS_MODEL=gpt-oss-120b

# Alternative AI Providers (optional)
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here

# =============================================================================
# TIMEOUT & PERFORMANCE CONFIGURATION
# =============================================================================

# AI Service timeout in seconds (default: 120)
AI_SERVICE_TIMEOUT=120

# Ollama timeout in seconds (default: 300 for local models)
OLLAMA_TIMEOUT=300

# LLM timeout in seconds
LLM_TIMEOUT=60

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_DEFAULT=3600

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MongoDB
MONGODB_URI=mongodb://localhost:27017/powercv
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=your-mongodb-password-change-in-production
MONGODB_POOL_SIZE=10
MONGODB_IDLE_TIMEOUT_MS=30000

# Redis (for caching and rate limiting)
REDIS_URL=redis://localhost:6379
REDIS_SOCKET_TIMEOUT=5

# PostgreSQL
POSTGRES_USER=powercv
POSTGRES_PASSWORD=your-postgres-password-change-in-production
POSTGRES_DB=powercv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_POOL_MIN=1
POSTGRES_POOL_MAX=10

# =============================================================================
# N8N WORKFLOW AUTOMATION
# =============================================================================

# n8n API Configuration - REQUIRES SECURE VALUE IN PRODUCTION
N8N_API_KEY=your-n8n-api-key-here
N8N_WEBHOOK_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=your-n8n-password-change-in-production
N8N_ENCRYPTION_KEY=your-n8n-encryption-key-change-in-production

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Sentry (Error Monitoring) - Optional
SENTRY_DSN=your-sentry-dsn-here

# =============================================================================
# FILE UPLOAD SETTINGS
# =============================================================================

# Maximum file size for uploads (10MB default)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/uploads

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# DOCKER COMPOSE DEFAULTS (can be overridden)
# =============================================================================

REQUEST_TIMEOUT=30
TIMEZONE=UTC

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
