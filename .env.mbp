# PowerCV — MacBook Pro (Apple Silicon) Local Configuration
# Copy adjustments as needed. Sources from .env for shared settings.
#
# Usage:
#   export $(grep -v '^#' .env.mbp | xargs)
#   docker compose -f docker-compose.infra.yml up -d
#   uvicorn app.main:app --reload --host 0.0.0.0 --port 8081

# =============================================================================
# APPLICATION
# =============================================================================
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=development-secret-key-mbp-local-2024

APP_HOST=0.0.0.0
APP_PORT=8081

# =============================================================================
# DATABASES — Docker infra on host-accessible ports
# =============================================================================
MONGODB_URI=mongodb://localhost:27018/powercv
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=powercv123

REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

POSTGRES_USER=powercv
POSTGRES_PASSWORD=powercv_dev_password_2024
POSTGRES_DB=powercv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# AI / LLM — turboquant llama-server (Qwen3.5-9B)
# =============================================================================
# Primary: turboquant exposes an OpenAI-compatible API at :8080/v1
OPENAI_API_KEY=not-needed
OPENAI_API_BASE=http://localhost:8080/v1
OPENAI_MODEL=qwen3.5-9b

# Ollama-compatible endpoint — also points at turboquant
OLLAMA_BASE_URL=http://localhost:8080
OLLAMA_MODEL=qwen3.5-9b
OLLAMA_TIMEOUT=300

# Disable cloud AI providers (no keys needed locally)
AI_PROVIDER=openai
CEREBRAS_API_KEY=
CEREBRAS_API_BASE=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# =============================================================================
# AI SERVICE (runs natively or disabled — turboquant replaces it)
# =============================================================================
AI_SERVICE_URL=http://localhost:8082
AI_SERVICE_PORT=8082
AI_SERVICE_TIMEOUT=300

# =============================================================================
# CACHE & RATE LIMITING
# =============================================================================
CACHE_TTL_DEFAULT=3600
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8081","http://localhost:8080"]

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/tmp/powercv-uploads
ALLOWED_FILE_TYPES=pdf,doc,docx,txt

# =============================================================================
# N8N — optional on MBP
# =============================================================================
N8N_API_KEY=powercv-local
N8N_WEBHOOK_URL=http://localhost:5678
N8N_USER=admin
N8N_PASSWORD=powercv-local
N8N_ENCRYPTION_KEY=powercv-local-encryption-key-change-me

# =============================================================================
# EXTERNAL (disabled locally)
# =============================================================================
SENTRY_DSN=
